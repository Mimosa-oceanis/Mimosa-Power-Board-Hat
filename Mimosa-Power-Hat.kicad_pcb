	(gr_text "Mimosa - Power Hat - V0\nDesigned by Jérôme Béguin 08.2020"
		(at 136.1 68.4 90)
		(layer "B.SilkS")
		(uuid "d8d71ad3-6fd1-4a98-9c1f-70c4fbf3d1d1")
