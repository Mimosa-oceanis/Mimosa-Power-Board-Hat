		)
	)
	(gr_text "This is a HAT compatible PCB starting design based on the official\nRaspberry Pi specs at:\nhttps://github.com/raspberrypi/hats/blob/master/designguide.md\n\nCurrently the camera slot and display cutout are not here. \nSee the schematic for the details on the EEPROM and power setup.\n\nThis board does have the correct components for powering the Pi via\nthe HAT. If you need the Pi to provide 5V or 3.3V, please remove or\nconnect the appropriate components."
		(at 189.4 83.7 0)
		(layer "Cmts.User")
		(uuid "80b9a57f-3326-43ca-b6ca-5e911992b3c4")
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.3)
			)
		)
	)
	(gr_text "If you want to use an SMT 40-pin header, please move the top edge up \nby 0.5mm and locate the header in the same location as the current TH part."
		(at 117.3 47.5 0)
		(layer "Cmts.User")
		(uuid "897277a3-b7ce-4d18-8c5f-1c984a246298")
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.3)
			)
		)
	)
